<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================
         PALETA INSTITUCIONAL (tomada del prototipo HTML)
         ===================================================== -->

    <Color x:Key="ColorAzulPrimario">#1F5E95</Color>
    <Color x:Key="ColorAzulPrimarioOscuro">#184A78</Color>
    <Color x:Key="ColorAzulClaro">#5FA8D3</Color>
    <Color x:Key="ColorAzulSuave">#EAF5FC</Color>
    <Color x:Key="ColorAzulOscuro">#163D63</Color>
    <Color x:Key="ColorFondo">#F8FCFF</Color>
    <Color x:Key="ColorTexto">#3E5266</Color>
    <Color x:Key="ColorTextoSuave">#7C93A8</Color>
    <Color x:Key="ColorBorde">#1F163D63</Color>
    <Color x:Key="ColorBordeFuerte">#AFC9DB</Color>

    <Color x:Key="ColorRojo">#C96A6A</Color>
    <Color x:Key="ColorRojoFondo">#FBEDED</Color>
    <Color x:Key="ColorRojoTexto">#A34848</Color>
    <Color x:Key="ColorVerde">#6BB58A</Color>
    <Color x:Key="ColorVerdeFondo">#EBF6EF</Color>
    <Color x:Key="ColorVerdeTexto">#2F7A52</Color>
    <Color x:Key="ColorAmarillo">#E7C76A</Color>
    <Color x:Key="ColorAmarilloFondo">#FCF6E7</Color>
    <Color x:Key="ColorAmarilloTexto">#8C6D14</Color>

    <SolidColorBrush x:Key="AzulPrimario" Color="{StaticResource ColorAzulPrimario}" />
    <SolidColorBrush x:Key="AzulPrimarioOscuro" Color="{StaticResource ColorAzulPrimarioOscuro}" />
    <SolidColorBrush x:Key="AzulClaro" Color="{StaticResource ColorAzulClaro}" />
    <SolidColorBrush x:Key="AzulSuave" Color="{StaticResource ColorAzulSuave}" />
    <SolidColorBrush x:Key="AzulOscuro" Color="{StaticResource ColorAzulOscuro}" />
    <SolidColorBrush x:Key="Fondo" Color="{StaticResource ColorFondo}" />
    <SolidColorBrush x:Key="Texto" Color="{StaticResource ColorTexto}" />
    <SolidColorBrush x:Key="TextoSuave" Color="{StaticResource ColorTextoSuave}" />
    <SolidColorBrush x:Key="Borde" Color="{StaticResource ColorBorde}" />
    <SolidColorBrush x:Key="BordeFuerte" Color="{StaticResource ColorBordeFuerte}" />

    <SolidColorBrush x:Key="Rojo" Color="{StaticResource ColorRojo}" />
    <SolidColorBrush x:Key="RojoFondo" Color="{StaticResource ColorRojoFondo}" />
    <SolidColorBrush x:Key="RojoTexto" Color="{StaticResource ColorRojoTexto}" />
    <SolidColorBrush x:Key="Verde" Color="{StaticResource ColorVerde}" />
    <SolidColorBrush x:Key="VerdeFondo" Color="{StaticResource ColorVerdeFondo}" />
    <SolidColorBrush x:Key="VerdeTexto" Color="{StaticResource ColorVerdeTexto}" />
    <SolidColorBrush x:Key="Amarillo" Color="{StaticResource ColorAmarillo}" />
    <SolidColorBrush x:Key="AmarilloFondo" Color="{StaticResource ColorAmarilloFondo}" />
    <SolidColorBrush x:Key="AmarilloTexto" Color="{StaticResource ColorAmarilloTexto}" />

    <!-- Barra lateral -->
    <SolidColorBrush x:Key="SidebarTexto" Color="#C9DCEB" />
    <SolidColorBrush x:Key="SidebarEtiqueta" Color="#7794AC" />
    <SolidColorBrush x:Key="SidebarSuave" Color="#9FC0DA" />
    <SolidColorBrush x:Key="SidebarHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SidebarActivo" Color="#2E5FA8D3" />
    <SolidColorBrush x:Key="SidebarCaja" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="SidebarLinea" Color="#14FFFFFF" />

    <!-- =====================================================
         TIPOGRAFÍA (archivos en Assets/Fonts)
         ===================================================== -->

    <FontFamily x:Key="FuenteUI">avares://CajaApp/Assets/Fonts#Public Sans</FontFamily>
    <FontFamily x:Key="FuenteMono">avares://CajaApp/Assets/Fonts#IBM Plex Mono</FontFamily>
    <!-- Variante seminegrita para cifras destacadas (montos, indicadores) -->
    <FontFamily x:Key="FuenteMonoFuerte">avares://CajaApp/Assets/Fonts#IBM Plex Mono SemiBold</FontFamily>

    <!-- =====================================================
         SOMBRAS
         ===================================================== -->

    <BoxShadows x:Key="SombraTarjeta">0 1 2 0 #0D163D63, 0 4 14 0 #10163D63</BoxShadows>
    <BoxShadows x:Key="SombraElevada">0 8 24 0 #26163D63</BoxShadows>

    <!-- =====================================================
         ÍCONOS (geometrías vectoriales, estilo Material)
         ===================================================== -->

