<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CajaApp.ViewModels"
             x:Class="CajaApp.Views.TransaccionView"
             x:DataType="vm:TransaccionViewModel">

    <StackPanel>

        <StackPanel Spacing="4" Margin="0,0,0,20">
            <TextBlock Classes="h1" Text="Nueva transacción" />
            <TextBlock Classes="sub" Text="Factura un servicio arancelado o registra una entrega cubierta por subsidio. Toda operación emite su comprobante." />
        </StackPanel>

        <!-- RESULTADO DE LA ÚLTIMA OPERACIÓN -->
        <Border Classes="notice verde" Margin="0,0,0,16" IsVisible="{Binding MensajeExito}">
            <DockPanel>
                <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconoCheck}" />
                <Button DockPanel.Dock="Right" Classes="secondary" Padding="12,6" FontSize="12.5"
                        IsVisible="{Binding HayComprobante}"
                        Command="{Binding AbrirComprobanteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource IconoImpresora}" Width="13" Height="13"
                                  Foreground="{StaticResource AzulPrimario}" Margin="0" />
                        <TextBlock Text="Ver comprobante PDF" Foreground="{StaticResource AzulPrimario}" FontSize="12.5" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Mensaje}" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
        <Border Classes="notice rojo" Margin="0,0,0,16" IsVisible="{Binding MensajeError}">
            <DockPanel>
                <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconoAlerta}" />
                <TextBlock Text="{Binding Mensaje}" />
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="1.3*,*" ColumnSpacing="16">

            <!-- ==========================================
                 DATOS DE LA OPERACIÓN
                 ========================================== -->
            <Border Classes="card" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Classes="h3" Text="Datos de la operación" Margin="0,0,0,16" />

                    <!-- CÉDULA + VALIDAR -->
                    <TextBlock Classes="label" Text="Cédula del beneficiario" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Classes="mono"
                                 Text="{Binding Cedula}"
                                 PlaceholderText="000-0000000-0"
                                 MaxLength="13" />
                        <Button Grid.Column="1" Classes="secondary"
                                Command="{Binding ValidarSubsidioCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconoEscudo}" />
                                <TextBlock Text="Validar subsidio" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Classes="hint" Text="Solo se solicita el dato necesario para emitir el comprobante. No se consulta información clínica." />

                    <!-- ESTADO DEL SUBSIDIO -->
                    <Border Margin="0,14,0,16" Padding="14,12" CornerRadius="9"
                            Background="{StaticResource Fondo}"
                            BorderBrush="{StaticResource Borde}" BorderThickness="1">
                        <DockPanel>
                            <Panel DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top">
                                <Border Classes="badge" IsVisible="{Binding SubsidioSinValidar}">
                                    <TextBlock Text="{Binding TextoEstadoSubsidio}" />
                                </Border>
                                <Border Classes="badge verde" IsVisible="{Binding SubsidioActivo}">
                                    <TextBlock Text="{Binding TextoEstadoSubsidio}" />
                                </Border>
                                <Border Classes="badge amarillo" IsVisible="{Binding SubsidioNoDisponible}">
                                    <TextBlock Text="{Binding TextoEstadoSubsidio}" />
                                </Border>
                            </Panel>
                            <TextBlock Text="{Binding DetalleSubsidio}" FontSize="12.5"
                                       Foreground="{StaticResource Texto}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- SERVICIO -->
                    <TextBlock Classes="label" Text="Servicio" />
                    <ComboBox ItemsSource="{Binding TiposServicio}"
                              SelectedItem="{Binding TipoServicio}"
                              Margin="0,0,0,16" />

                    <!-- RECETA (solo medicamentos: enlaza el descargo con Farmacia) -->
                    <StackPanel IsVisible="{Binding RequiereReceta}" Margin="0,0,0,16">
                        <TextBlock Classes="label" Text="Número de receta" />
                        <TextBox Classes="mono"
                                 Text="{Binding NumeroReceta}"
                                 PlaceholderText="Ejemplo: 15"
                                 MaxLength="20" />
                        <TextBlock Classes="hint" Text="Número de la receta del CORE (si dice REC-15, escribe 15). Farmacia solo despacha recetas descargadas en Caja." />
                    </StackPanel>

                    <!-- MONTO Y FORMA DE PAGO -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Classes="label" Text="Monto" />
                            <TextBox Classes="grande"
                                     Text="{Binding MontoTexto}"
                                     PlaceholderText="0.00"
                                     IsEnabled="{Binding PuedeEditarCobro}">
                                <TextBox.InnerLeftContent>
                                    <TextBlock Classes="prefijo" Text="RD$" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="label" Text="Forma de pago" />
                            <ComboBox ItemsSource="{Binding FormasPago}"
                                      SelectedItem="{Binding FormaPago}"
                                      IsEnabled="{Binding PuedeEditarCobro}" />
                        </StackPanel>
                    </Grid>

                    <Border Classes="notice verde" Margin="0,0,0,14" IsVisible="{Binding EsSubsidiado}">
                        <DockPanel>
                            <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconoCheck}" />
                            <TextBlock Text="Entrega de Medicamentos ARV con subsidio activo: se registra con gratuidad y el total se ajusta a RD$ 0.00 (RN-02)." TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <Border Classes="notice amarillo" Margin="0,0,0,14" IsVisible="{Binding SubsidioNoCubreServicio}">
                        <DockPanel>
                            <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconoAlerta}" />
                            <TextBlock Text="El subsidio cubre solo Medicamentos ARV. Este servicio es arancelado y se cobra normalmente (RF-CAJ-04)." TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <Border Classes="notice amarillo" Margin="0,0,0,14" IsVisible="{Binding EsArvSinSubsidio}">
                        <DockPanel>
                            <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconoAlerta}" />
                            <TextBlock Text="Los medicamentos ARV son gratuitos para beneficiarios con subsidio. Valida la cédula antes de cobrar." />
                        </DockPanel>
                    </Border>

                    <!-- TOTAL -->
                    <Border Classes="totalBox" Classes.free="{Binding EsSubsidiado}" Margin="0,0,0,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="lbl" Text="{Binding EtiquetaTotal}" />
                            <TextBlock Grid.Column="1" Classes="val" Text="{Binding TotalTexto}" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Button Classes="ghost" Content="Limpiar" Command="{Binding LimpiarCommand}" />
                        <Button Grid.Column="1" Classes="primary"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ProcesarTransaccionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconoRecibo}" />
                                <TextBlock Text="{Binding TextoBotonRegistrar}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==========================================
                 VISTA PREVIA DEL COMPROBANTE
                 ========================================== -->
            <StackPanel Grid.Column="1" Spacing="16">
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="h3" Text="Vista previa del comprobante" Margin="0,0,0,14" />

                        <Grid>
                            <Rectangle RadiusX="10" RadiusY="10"
                                       Stroke="{StaticResource AzulClaro}"
                                       StrokeThickness="1.5"
                                       StrokeDashArray="4,3"
                                       Fill="White" />
                            <StackPanel Margin="20,18">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Image Source="avares://CajaApp/Assets/logo-icono.png" Width="30" Height="30" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="CONAVIHSIDA" FontWeight="Bold" FontSize="13"
                                                       Foreground="{StaticResource AzulOscuro}" />
                                            <TextBlock Text="Comprobante de operación" Classes="muted" FontSize="11.5" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="No. se asigna al registrar" Classes="muted" FontSize="11" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding PreviewFecha}" Classes="muted mono" FontSize="11" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{StaticResource Borde}" Margin="0,0,0,10" />

                                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                    <TextBlock Classes="mono" FontSize="12.5" Text="Beneficiario" />
                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="12.5" Text="{Binding PreviewCedula}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                    <TextBlock Classes="mono" FontSize="12.5" Text="Servicio" />
                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="12.5" Text="{Binding TipoServicio}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,3" IsVisible="{Binding RequiereReceta}">
                                    <TextBlock Classes="mono" FontSize="12.5" Text="Receta" />
                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="12.5" Text="{Binding PreviewReceta}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                    <TextBlock Classes="mono" FontSize="12.5" Text="Forma de pago" />
                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="12.5" Text="{Binding PreviewPago}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                    <TextBlock Classes="mono" FontSize="12.5" Text="Cajero" />
                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="12.5" Text="{Binding PreviewCajero}" />
                                </Grid>

                                <Border Height="1.5" Background="{StaticResource AzulOscuro}" Margin="0,10,0,8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="amount" FontSize="14" Text="Total" />
                                    <TextBlock Grid.Column="1" Classes="amount" FontSize="14" Text="{Binding TotalTexto}" />
                                </Grid>
                                <TextBlock Margin="0,8,0,0" FontSize="11.5"
                                           Foreground="{StaticResource VerdeTexto}"
                                           IsVisible="{Binding EsSubsidiado}"
                                           Text="Entrega subsidiada · Balance del paciente RD$ 0.00" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>

    </StackPanel>

</UserControl>
