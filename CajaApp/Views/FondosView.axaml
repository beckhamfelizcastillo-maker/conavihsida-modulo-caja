<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CajaApp.ViewModels"
             xmlns:items="using:CajaApp.ViewModels.Items"
             x:Class="CajaApp.Views.FondosView"
             x:DataType="vm:FondosViewModel">

    <StackPanel>

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Fondos y convenios" />
                <TextBlock Classes="sub" Text="Partidas autorizadas del Estado dominicano y de la cooperación internacional." />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" VerticalAlignment="Bottom"
                    Command="{Binding AlternarFormularioCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconoMas}" />
                    <TextBlock Text="{Binding TextoBotonFormulario}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- TOTALES (fondos activos) -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" Margin="0,0,0,20">
            <Border Classes="stat">
                <StackPanel>
                    <TextBlock Classes="statLabel" Text="Total asignado" />
                    <TextBlock Classes="statValue" Text="{Binding TotalAsignado}" />
                    <TextBlock Classes="statSub" Text="{Binding Resumen}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="stat amarillo">
                <StackPanel>
                    <TextBlock Classes="statLabel" Text="Total utilizado" />
                    <TextBlock Classes="statValue" Text="{Binding TotalUtilizado}" />
                    <TextBlock Classes="statSub" Text="Descargos aplicados a subsidios" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="stat verde">
                <StackPanel>
                    <TextBlock Classes="statLabel" Text="Saldo disponible" />
                    <TextBlock Classes="statValue" Text="{Binding TotalDisponible}" />
                    <TextBlock Classes="statSub" Text="Asignado menos utilizado" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- MENSAJES -->
        <Border Classes="notice verde" Margin="0,0,0,16" IsVisible="{Binding MensajeExito}">
            <DockPanel>
                <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconoCheck}" />
                <TextBlock Text="{Binding Mensaje}" />
            </DockPanel>
        </Border>
        <Border Classes="notice rojo" Margin="0,0,0,16" IsVisible="{Binding MensajeError}">
            <DockPanel>
                <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconoAlerta}" />
                <TextBlock Text="{Binding Mensaje}" />
            </DockPanel>
        </Border>

        <!-- FORMULARIO DE NUEVA PARTIDA -->
        <Border Classes="card" Margin="0,0,0,20" IsVisible="{Binding MostrarFormulario}">
            <StackPanel>
                <TextBlock Classes="h3" Text="Registrar nueva partida" Margin="0,0,0,16" />

                <Grid ColumnDefinitions="*,2*,*" ColumnSpacing="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Código" />
                        <TextBox Classes="mono" Text="{Binding Codigo}" PlaceholderText="FONDO-EST-2027" MaxLength="40" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="label" Text="Nombre del fondo o convenio" />
                        <TextBox Text="{Binding Nombre}" PlaceholderText="Presupuesto Estatal 2027" MaxLength="150" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="label" Text="Origen" />
                        <ComboBox ItemsSource="{Binding TiposFuente}" SelectedItem="{Binding TipoFuente}" />
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="2*,1.4*,*,*" ColumnSpacing="14" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Organismo" />
                        <TextBox Text="{Binding Organismo}" PlaceholderText="Gobierno Dominicano / Fondo Mundial" MaxLength="250" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="label" Text="Monto asignado" />
                        <TextBox Classes="grande" Text="{Binding MontoAsignadoTexto}" PlaceholderText="0.00">
                                <TextBox.InnerLeftContent>
                                    <TextBlock Classes="prefijo" Text="RD$" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="label" Text="Desde" />
                        <DatePicker SelectedDate="{Binding FechaInicio}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Classes="label" Text="Hasta" />
                        <DatePicker SelectedDate="{Binding FechaFin}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="primary" Command="{Binding CrearFondoCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconoCheck}" />
                            <TextBlock Text="Guardar partida" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Content="Cancelar" Command="{Binding AlternarFormularioCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- TABLA DE PARTIDAS -->
        <Border Classes="card">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Classes="h3" Text="Partidas registradas" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="link" Command="{Binding ActualizarCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconoRefrescar}" Width="13" Height="13" />
                            <TextBlock Text="Actualizar" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Classes="thead">
                    <Grid ColumnDefinitions="1.3*,2.1*,1.35*,1.75*,1.75*,1.45*,0.9*,0.9*">
                        <TextBlock Grid.Column="0" Classes="th" Text="CÓDIGO" />
                        <TextBlock Grid.Column="1" Classes="th" Text="NOMBRE / ORGANISMO" />
                        <TextBlock Grid.Column="2" Classes="th" Text="ORIGEN" />
                        <TextBlock Grid.Column="3" Classes="th" Text="ASIGNADO" />
                        <TextBlock Grid.Column="4" Classes="th" Text="DISPONIBLE" />
                        <TextBlock Grid.Column="5" Classes="th" Text="VIGENCIA" />
                        <TextBlock Grid.Column="6" Classes="th" Text="ESTADO" />
                        <TextBlock Grid.Column="7" Classes="th" Text="" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Fondos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="items:FondoItem">
                            <Border Classes="row">
                                <Grid ColumnDefinitions="1.3*,2.1*,1.35*,1.75*,1.75*,1.45*,0.9*,0.9*">
                                    <TextBlock Grid.Column="0" Classes="td mono" FontSize="12" Text="{Binding Codigo}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Classes="td" FontWeight="SemiBold" Foreground="{StaticResource AzulOscuro}" Text="{Binding Nombre}" />
                                        <TextBlock Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" Text="{Binding Organismo}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="td" Text="{Binding Fuente}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="3" Classes="td amount" FontSize="12" Text="{Binding Asignado}" />
                                    <TextBlock Grid.Column="4" Classes="td amount" FontSize="12" Text="{Binding Disponible}" />
                                    <TextBlock Grid.Column="5" Classes="td mono" FontSize="11.5" Text="{Binding Vigencia}" TextWrapping="Wrap" />
                                    <Panel Grid.Column="6">
                                        <Border Classes="badge verde" IsVisible="{Binding Activo}">
                                            <TextBlock Text="Activo" />
                                        </Border>
                                        <Border Classes="badge rojo" IsVisible="{Binding Inactivo}">
                                            <TextBlock Text="Inactivo" />
                                        </Border>
                                    </Panel>
                                    <Button Grid.Column="7" Classes="link"
                                            HorizontalAlignment="Right"
                                            Content="{Binding TextoAccion}"
                                            Command="{Binding $parent[UserControl].((vm:FondosViewModel)DataContext).CambiarEstadoCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel IsVisible="{Binding SinFondos}" Margin="0,30,0,18" Spacing="8">
                    <PathIcon Data="{StaticResource IconoBanco}" Width="28" Height="28"
                              Foreground="#B6C6D4" HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" FontSize="13" HorizontalAlignment="Center"
                               Text="No hay fondos registrados." />
                </StackPanel>
            </StackPanel>
        </Border>

    </StackPanel>

</UserControl>
