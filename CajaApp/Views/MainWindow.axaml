<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CajaApp.ViewModels"
        x:Class="CajaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CONAVIHSIDA · Sistema de Caja"
        Icon="/Assets/conavihsida.ico"
        Width="1320"
        Height="840"
        MinWidth="960"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FuenteUI}"
        Foreground="{StaticResource Texto}"
        Background="{StaticResource Fondo}">

    <ContentControl Content="{Binding CurrentViewModel}" />

</Window>
