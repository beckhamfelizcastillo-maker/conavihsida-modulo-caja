<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CajaApp.ViewModels"
             xmlns:items="using:CajaApp.ViewModels.Items"
             x:Class="CajaApp.Views.InicioView"
             x:DataType="vm:InicioViewModel">

    <StackPanel Spacing="0">

        <!-- ENCABEZADO -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="{Binding Saludo}" />
                <TextBlock Classes="sub" Text="Este es el resumen de tu turno actual en la ventanilla de Caja." />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="muted" FontSize="12.5"
                       VerticalAlignment="Bottom"
                       Text="{Binding FechaHoy}" />
        </Grid>

        <!-- AVISO SIN CAJA -->
        <Border Classes="notice amarillo" Margin="0,0,0,20" IsVisible="{Binding CajaCerrada}">
            <DockPanel>
                <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconoAlerta}" />
                <Button DockPanel.Dock="Right" Classes="link" FontWeight="Bold"
                        Foreground="{StaticResource AmarilloTexto}"
                        Content="Abrir caja →"
                        Command="{Binding IrAperturaCommand}" />
                <TextBlock Text="Aún no has abierto tu caja. Abre tu turno para habilitar transacciones y el cierre." />
            </DockPanel>
        </Border>

        <!-- INDICADORES -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16" Margin="0,0,0,24">

            <Border Grid.Column="0" Classes="stat">
                <StackPanel>
                    <TextBlock Classes="statLabel" Text="Estado de caja" />
                    <TextBlock Classes="statValue" Text="{Binding EstadoCaja}" FontSize="19"
                               FontFamily="{StaticResource FuenteUI}" FontWeight="Bold" />
                    <TextBlock Classes="statSub" Text="{Binding DetalleEstado}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="stat verde">
                <StackPanel>
                    <TextBlock Classes="statLabel" Text="Total cobrado en el turno" />
                    <TextBlock Classes="statValue" Text="{Binding TotalCobrado}" />
                    <TextBlock Classes="statSub" Text="{Binding TextoCobros}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="stat amarillo">
                <StackPanel>
                    <TextBlock Classes="statLabel" Text="Entregas subsidiadas" />
                    <TextBlock Classes="statValue" Text="{Binding CantidadSubsidiadas}" />
                    <TextBlock Classes="statSub" Text="Gratuidad aplicada (RD$ 0.00)" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Classes="stat azul">
                <StackPanel>
                    <TextBlock Classes="statLabel" Text="Efectivo esperado en caja" />
                    <TextBlock Classes="statValue" Text="{Binding EfectivoEsperado}" />
                    <TextBlock Classes="statSub"><Run Text="Balance inicial: " /><Run Text="{Binding BalanceInicial}" /></TextBlock>
                </StackPanel>
            </Border>

        </Grid>

        <!-- ACCIONES RÁPIDAS -->
        <TextBlock Classes="h3" Text="Acciones rápidas" Margin="0,0,0,12" />

        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14" Margin="0,0,0,24">

            <Button Grid.Column="0" Classes="quick"
                    Command="{Binding IrAperturaCommand}"
                    IsEnabled="{Binding CajaCerrada}">
                <StackPanel>
                    <Border Classes="iconBox"><PathIcon Data="{StaticResource IconoAbrir}" /></Border>
                    <TextBlock Classes="t" Text="Abrir caja" />
                    <TextBlock Classes="d" Text="Inicia tu turno con el balance inicial autorizado." />
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Classes="quick"
                    Command="{Binding IrTransaccionCommand}"
                    IsEnabled="{Binding HayTurnoAbierto}">
                <StackPanel>
                    <Border Classes="iconBox"><PathIcon Data="{StaticResource IconoRecibo}" /></Border>
                    <TextBlock Classes="t" Text="Nueva transacción" />
                    <TextBlock Classes="d" Text="Registra un cobro o una entrega subsidiada." />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Classes="quick"
                    Command="{Binding IrSubsidioCommand}">
                <StackPanel>
                    <Border Classes="iconBox"><PathIcon Data="{StaticResource IconoEscudo}" /></Border>
                    <TextBlock Classes="t" Text="Validar subsidio" />
                    <TextBlock Classes="d" Text="Confirma la elegibilidad financiera antes de cobrar." />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Classes="quick"
                    Command="{Binding IrCierreCommand}"
                    IsEnabled="{Binding HayTurnoAbierto}">
                <StackPanel>
                    <Border Classes="iconBox"><PathIcon Data="{StaticResource IconoBalanza}" /></Border>
                    <TextBlock Classes="t" Text="Cuadre y cierre" />
                    <TextBlock Classes="d" Text="Compara lo esperado con lo contado y cierra el turno." />
                </StackPanel>
            </Button>

        </Grid>

        <!-- PENDIENTES DE SINCRONIZAR -->
        <Border Classes="notice" Margin="0,0,0,20" IsVisible="{Binding HayPendientes}">
            <DockPanel>
                <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconoSync}" />
                <TextBlock><Run Text="{Binding TextoPendientes}" FontWeight="SemiBold" /><Run Text=". Caja sigue operando y los enviará a Integration automáticamente cuando haya conexión." /></TextBlock>
            </DockPanel>
        </Border>

        <!-- ÚLTIMOS MOVIMIENTOS -->
        <Border Classes="card">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Classes="h3" Text="{Binding TituloMovimientos}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="link"
                            Content="Ver historial completo →"
                            Command="{Binding IrHistorialCommand}" />
                </Grid>

                <!-- Encabezado de la tabla -->
                <Border Classes="thead">
                    <Grid ColumnDefinitions="2*,1*,3*,1.6*,1.4*,1.2*">
                        <TextBlock Grid.Column="0" Classes="th" Text="NO." />
                        <TextBlock Grid.Column="1" Classes="th" Text="HORA" />
                        <TextBlock Grid.Column="2" Classes="th" Text="SERVICIO" />
                        <TextBlock Grid.Column="3" Classes="th" Text="PAGO" />
                        <TextBlock Grid.Column="4" Classes="th" Text="MONTO" />
                        <TextBlock Grid.Column="5" Classes="th" Text="TIPO" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding UltimosMovimientos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="items:TransaccionItem">
                            <Border Classes="row">
                                <Grid ColumnDefinitions="2*,1*,3*,1.6*,1.4*,1.2*">
                                    <TextBlock Grid.Column="0" Classes="td mono" FontSize="12" Text="{Binding Numero}" />
                                    <TextBlock Grid.Column="1" Classes="td mono" FontSize="12" Text="{Binding Hora}" />
                                    <TextBlock Grid.Column="2" Classes="td" Text="{Binding Servicio}" />
                                    <TextBlock Grid.Column="3" Classes="td" Text="{Binding FormaPago}" />
                                    <TextBlock Grid.Column="4" Classes="td amount" Text="{Binding Monto}" />
                                    <Panel Grid.Column="5">
                                        <Border Classes="badge verde" IsVisible="{Binding EsSubsidiado}">
                                            <TextBlock Text="Subsidiado" />
                                        </Border>
                                        <Border Classes="badge" IsVisible="{Binding EsCobrado}">
                                            <TextBlock Text="Cobrado" />
                                        </Border>
                                    </Panel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Estado vacío -->
                <StackPanel IsVisible="{Binding SinMovimientos}" Margin="0,30,0,18" Spacing="8">
                    <PathIcon Data="{StaticResource IconoRecibo}" Width="28" Height="28"
                              Foreground="#B6C6D4" HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" FontSize="13" HorizontalAlignment="Center"
                               Text="Todavía no se han registrado operaciones en este turno." />
                </StackPanel>
            </StackPanel>
        </Border>

    </StackPanel>

</UserControl>
